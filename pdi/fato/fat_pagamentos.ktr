      <schema_name/>
    </partitioning>
    <connection>cnx_prd_olist</connection>
    <sql>SELECT
    -- dimensoes
    p.id_cliente,
    p.dt_movimento::date AS nk_tempo,
    pp.tipo_pagamento,

    -- rastreamento
    p.id_pedido,

    -- metricas
    pp.nr_item_pagamento,
    pp.vl_transacao      AS vl_movimento,
    pp.nr_parcelas_pagamento
FROM producao.pedidos p
JOIN producao.pedido_pagamento pp
ON p.id_pedido = pp.id_pedido</sql>
    <limit>0</limit>
    <lookup/>
    <execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active>
    <lazy_conversion_active>N</lazy_conversion_active>
